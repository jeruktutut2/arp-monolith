# ========================================================
# Enterprise ERP Monolith — Backend Environment Config
# ========================================================

# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development # development | staging | production

# Database via PgBouncer (Port 6432 with Transaction Pooling)
DATABASE_URL=postgres://erp_user:erp_secret@localhost:6432/erp_db?sslmode=disable

# Direct PostgreSQL Connection for golang-migrate DDL (Port 5432)
DIRECT_DATABASE_URL=postgres://erp_user:erp_secret@localhost:5432/erp_db?sslmode=disable

# PgBouncer Connection Pool Settings for pgxpool
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# JWT & Authentication
JWT_SECRET=super-secret-erp-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
